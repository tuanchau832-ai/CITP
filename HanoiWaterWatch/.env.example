# Copy to .env and supply random secrets before Docker Compose.
DATABASE_URL=postgresql+asyncpg://hww:hww@db:5432/hww
POSTGRES_PASSWORD=replace-with-a-random-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=true
DEMO_MODE=true
REPLAY_TLH_ENABLED=true
INGEST_ENABLED=true
OFFLINE_AFTER_S=15
SESSION_END_AFTER_S=60
RETENTION_DAYS=7
PUBLIC_BASE_URL=http://localhost:8000
WOKWI_PROJECT_URL=
DEMO_OPERATOR_USERNAME=
DEMO_OPERATOR_PASSWORD=
DEMO_REVIEWER_USERNAME=
DEMO_REVIEWER_PASSWORD=
DEMO_ADMIN_USERNAME=
DEMO_ADMIN_PASSWORD=

